APP_HOST=0.0.0.0
APP_PORT=5234
APP_PUBLISHED_HOST=127.0.0.1
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-string
FLYMANAGER_ENV_FILE=.env

MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=flymanager
MONGO_PUBLISHED_HOST=127.0.0.1
MONGO_PUBLISHED_PORT=27017
WAIT_FOR_MONGO=1
WAIT_FOR_MONGO_TIMEOUT=60
WAIT_FOR_MONGO_INTERVAL=2

UPLOAD_FOLDER=data/uploads
SESSION_FILE_DIR=/tmp/flymanager/flask_session
SESSION_LIFETIME_SECONDS=3600
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_SIZE_BYTES=8388608
TRUST_PROXY_HEADERS=0
CORS_ALLOWED_ORIGINS=
ORG_ABV=RU
ENABLE_SCHEDULER=1
SOCKETIO_ASYNC_MODE=threading
MAIL_SUPPRESS_SEND=0

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

FLYMANAGER_ADMIN_USERNAME=
FLYMANAGER_ADMIN_PASSWORD=
FLYMANAGER_ADMIN_INITIALS=

FLYMANAGER_DOMAIN=flymanager.example.com
HTTP_PUBLISHED_PORT=80
HTTPS_PUBLISHED_PORT=443

BACKUP_ROOT=backups
MONGO_BACKUP_DIR=backups/mongodb
STATE_BACKUP_DIR=backups/state
BACKUP_LOG_DIR=backups/logs
BACKUP_OFFSITE_DIR=
BACKUP_KEEP_RECENT=48
BACKUP_KEEP_DAILY=14
STATE_BACKUP_KEEP_RECENT=14
STATE_BACKUP_KEEP_DAILY=30
BACKUP_INCLUDE_CADDY=auto
RESTORE_INCLUDE_CADDY=auto
RESTORE_PRECHECK_DIR=backups/restore-preflight