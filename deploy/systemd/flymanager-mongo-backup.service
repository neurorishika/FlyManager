[Unit]
Description=FlyManager MongoDB backup
Documentation=https://github.com/neurorishika/FlyManager
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/flymanager
Environment="COMPOSE_ARGS=-f compose.yaml -f compose.production.yaml"
EnvironmentFile=-/etc/default/flymanager-backups
ExecStart=/bin/sh -lc './scripts/mongo-backup.sh'

[Install]
WantedBy=multi-user.target