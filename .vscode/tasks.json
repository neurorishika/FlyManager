a genes3rd second', lambda: get_metadata('genes3rd', db))\n    timed('stock phenotype summary', lambda: _get_stock_phenotype_summary(stock))\n\nwith app.test_client() as client:\n    with client.session_transaction() as sess:\n        sess['username'] = username\n    if stock_id:\n        timed('GET /stock/explorer', lambda: client.get('/stock/explorer'))\n        timed(f'GET /stock/view/{stock_id}', lambda: client.get(f'/stock/view/{stock_id}'))\n    timed('GET /cross/cross_explorer', lambda: client.get('/cross/cross_explorer'))\nPY"
